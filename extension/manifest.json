{
  "manifest_version": 3,
  "name": "SavedLens V3 — AI Akıllı Kaydedilenler & İkinci Beyin",
  "version": "3.0.0",
  "description": "Instagram, Twitter, TikTok, YouTube ve web içeriklerinizi tek tıkla SavedLens kütüphanenize aktarın, yedekleyin ve AI ile etiketleyin.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SavedLens Sync",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://savedlens.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
