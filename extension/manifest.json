{
  "manifest_version": 3,
  "name": "SavedLens — Instagram & Sosyal Medya Senkronizasyonu",
  "version": "1.0.0",
  "description": "Instagram ve sosyal medya kaydedilenlerinizi tek tıkla SavedLens kütüphanenize aktarın, yedekleyin ve AI ile etiketleyin.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*",
    "https://*.savedlens.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SavedLens Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
