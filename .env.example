# ==============================================================================
# SavedLens Environment Variables Example
# Copy this file to .env.local and fill in the values for your project.
# ==============================================================================

# Supabase Database & Auth (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI API Key (GPT-4o-mini RAG Assistant & Text-Embedding-3-Small)
OPENAI_API_KEY=sk-your-openai-api-key

# Telegram Bot Integration (BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=your-secure-random-webhook-secret-token
